# ==========================
# Required
# ==========================

# MongoDB connection string
MONGO_CONNECTION_URI=

# JWT signing secret (must be set — no fallback)
JWT_SECRET=

# ==========================
# Optional (have defaults)
# ==========================

# Server port (default: 3000)
# PORT=3000

# JWT token expiration (default: '7d')
# JWT_EXPIRES_IN=7d

# Environment: development | production
# NODE_ENV=development

# CORS allowed origin (default: 'https://your-app.com')
# FRONTEND_URL=http://localhost:3000

# ==========================
# AWS S3 (required for file uploads)
# ==========================

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY_ID=
AWS_BUCKET_NAME=

# Pre-signed URL expiration in seconds
# AWS_PRE_SIGN_URL_EXPIRES_IN=

# Application name used in S3 key prefixes
# APPLICATION_NAME=

# ==========================
# Socket.IO (required for real-time cart)
# ==========================

# Socket server port (default: 3001)
# SOCKET_PORT=3001

# Shared secret for AI vision system socket auth
AI_SOCKET_SECRET=

# ==========================
# Quick Start (after cloning)
# ==========================
# 1. cp .env.example .env
# 2. Fill in MONGO_CONNECTION_URI and JWT_SECRET
# 3. npm install
# 4. npm run seed       ← populates the database with demo data
# 5. npm run start:dev  ← starts the API server
